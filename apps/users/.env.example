PORT=3006

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=salescart
DB_PASSWORD=salescart
DB_DATABASE=salescart

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1h

# Seeds one admin account on boot if it doesn't already exist. Public
# registration can never create an admin — this is the only way.
ADMIN_EMAIL=admin@salescart.dev
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=SalesCart Admin

# Required on every request; only the gateway or another internal service should ever send this.
INTERNAL_API_KEY=dev-internal-key-change-me
