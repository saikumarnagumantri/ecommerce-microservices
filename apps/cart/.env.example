PORT=3004

# Downstream services this service calls directly (service-to-service HTTP).
PRODUCTS_URL=http://localhost:3002/products
INVENTORY_URL=http://localhost:3003/inventory

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=salescart
DB_PASSWORD=salescart
DB_DATABASE=salescart

# Must match the users service's JWT_SECRET — this service verifies
# tokens issued by users directly (no gateway to trust yet; that's E6).
JWT_SECRET=dev-secret-change-me

# Required on every request; only the gateway or another internal service should ever send this.
INTERNAL_API_KEY=dev-internal-key-change-me
