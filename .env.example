# Infra (used by `npm run start:infra`, i.e. infra/docker-compose.yml).
# docker compose reads this file automatically from the directory `npm run start:infra` is run from (repo root).
# Copy this file to .env and adjust if you need non-default ports/credentials.

POSTGRES_USER=salescart
POSTGRES_PASSWORD=salescart
POSTGRES_DB=salescart
POSTGRES_PORT=5432

REDIS_PORT=6379
